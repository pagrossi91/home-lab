# homeassistant/.env — copy to .env and fill in. See CLAUDE.md.
# Real values live only in .env (gitignored) and the Time Capsule backup.

SERVER_IP=192.168.X.X            # LAN address of the Docker host
TZ=America/New_York
APPDATA_DIR=. # This for most OS setups, excluding Unraid
# APPDATA_DIR=/mnt/user/appdata/homeassistant # This is for Unraid setups
# MEDIADATA_DIR=../../RAIDdir # Customize this for where your media storage lives. For example, this maps to a RAID array
ARRAY_DIR=/mnt/user/vault # Maps to Unraid array

#HA_APPDAEMON_KEY=some long access token
#VSCODE_PASSWORD=password
LOCAL_USER=1000
HA_USER=ha_user # Used for MariaDB, InfluxDB
#VNC_PASSWORD=password

## MariaDB database
MYSQL_ROOT_PASSWORD=changeme-mariadb-root-password
MYSQL_DATABASE=ha_db
MYSQL_HA_PASSWORD=changeme-mariadb-ha-password
# DB_URL=mysql://${MYSQL_USER}:${MYSQL_HA_PASSWORD}@${SERVER_IP}/${MYSQL_DATABASE}?charset=utf8mb4 # This isn't needed because it's defined in the secrets.yaml file as plain text. I'd like to define all secret variables here so that all secrets are kept only in .env

ZWAVE_SECRETKEY=changeme-zwave-network-key
#zwavejs2mqtt_s0legacykey=
#zwavejs2mqtt_s2unauthkey=
#zwavejs2mqtt_s2authkey=
#zwavejs2mqtt_s2accessctrlkey=

INFLUXDB2_PWD='changeme-influxdb-password'
INFLUXDB2_ADMINTOKEN='changeme-influxdb-admin-token'

mosquitto_pwd='changeme-mosquitto-password'

# Amcrest/Dahua camera LAN addresses. Frigate reads these via the
# FRIGATE_CAM_*_IP env vars in docker-compose.yml, which keeps the real
# addresses out of the tracked frigate/config/config.yml.
amcrest_ip_frontdoorbell=192.168.X.X
amcrest_ip_sidedoorbell=192.168.X.X
amcrest_ip_backyard=192.168.X.X
amcrest_ip_livingroom=192.168.X.X
amcrest_pwd='changeme-camera-password'
