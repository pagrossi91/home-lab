# network-services/.env — copy to .env and fill in. See CLAUDE.md.
# Real values live only in .env (gitignored) and the Time Capsule backup.
#
# Note: the 172.18.x / 172.31.x addresses are Docker bridge networks, not LAN
# addresses. They are kept real on purpose — the compose file is unreadable
# without them and they reveal nothing about the network.

# User and timezone settings
SERVER_IP=192.168.X.X
TZ=America/New_York
LOCAL_USER=1000
APPDATA_DIR=. # This for most OS setups, excluding Unraid
# APPDATA_DIR=/mnt/user/appdata/network-services # This is for Unraid setups

# Static IP Addresses on NGINX Docker Network
NGINX_NETWORK_SUBNET=172.18.0.0/16
NGINX_NETWORK_GATEWAY=172.18.0.1
PIHOLE_STATIC_IP=172.18.0.10
DNSCRYPTSERVER_STATIC_IP=172.18.0.11
DNSCRYPTPROXY_STATIC_IP=172.18.0.12
SWAG_STATIC_IP=172.18.0.99

# DuckDNS configuration
DUCKDNS=yourdomain
DUCKDNS_TOKEN=changeme-duckdns-token
DOMAIN=${DUCKDNS}.duckdns.org

# SSL certificate email (for Let's Encrypt/ZeroSSL)
SSL_EMAIL=you@example.com

# Pi-hole admin interface password and DHCP bounds
PIHOLE_WEBPASSWORD="changeme-pihole-web-password"
DHCP_START=192.168.X.101
DHCP_END=192.168.X.253
DHCP_ROUTER_IP=192.168.X.254

# Pi-hole sync (host webport is 81, so the port must be included)
PIHOLE_1_URL=http://192.168.X.X:81
PIHOLE_1_PWD=${PIHOLE_WEBPASSWORD}
PIHOLE_2_URL=http://192.168.X.X:81
PIHOLE_2_PWD=${PIHOLE_1_PWD}

# Wireguard
PIHOLE_RPI3=192.168.X.X
PIHOLE_UNRAID=192.168.X.X
INTERNAL_SUBNET=10.13.14.0
WG_NETWORK_SUBNET=172.31.0.0/24
WG_NETWORK_GATEWAY=172.31.0.1
WG_STATIC_IP=172.31.0.2

# Watchtower email notifications.
# For Gmail this must be an App Password, not the account password.
WATCHTOWER_NOTIFICATION_EMAIL_FROM=you@example.com
WATCHTOWER_NOTIFICATION_EMAIL_TO=you@example.com
WATCHTOWER_NOTIFICATION_EMAIL_SERVER=smtp.gmail.com
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT=587
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_USER=you@example.com
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=changeme-smtp-app-password
