# media-services/.env — copy to .env and fill in. See CLAUDE.md.
# Real values live only in .env (gitignored) and the Time Capsule backup.
#
# Note: the 172.19.x static IPs below are Docker bridge addresses, not LAN
# addresses. They are kept real on purpose — the compose file is unreadable
# without them and they reveal nothing about the network.

TZ=America/New_York
APPDATA_DIR=. # This for most OS setups
ARRAY_DIR=/mnt/user/vault # Maps to Unraid array

# WireGuard private keys for the gluetun VPN container. Generate per provider.
Nord_PRIVATEKEY=changeme-nordvpn-wireguard-private-key
# Nord_IP=10.5.0.2/32
Nord_P2P_SERVERS=us0000.nordvpn.com, us0000.nordvpn.com

Proton_PRIVATEKEY=changeme-protonvpn-wireguard-private-key
Proton_P2P_SERVERS=


LOCAL_USER=1000
PLEX_CLAIM=claim-changeme #https://www.plex.tv/claim/
LAN_SUBNET=192.168.X.0/24 #, 172.18.0.0/16
ADVERTISED_IPS=http://192.168.X.X:32400/, https://plex.yourdomain.duckdns.org:443
SERVER_IP=192.168.X.X

NZBGET_USER=nzbget #optional
NZBGET_PASS=changeme-nzbget-password #optional

PROWLARR_STATIC_IP=172.19.0.10
RADARR_STATIC_IP=172.19.0.11
RADARR4K_STATIC_IP=172.19.0.111
SONARR_STATIC_IP=172.19.0.12
SONARR4K_STATIC_IP=172.19.0.121
# LIDARR_STATIC_IP=172.19.0.13
BAZARR_STATIC_IP=172.19.0.14
SEERR_STATIC_IP=172.19.0.15
SABNZBD_STATIC_IP=172.19.0.16
# NZBGET_STATIC_IP=172.19.0.17
# NZBHYDRA2_STATIC_IP=172.19.0.18
NAVIDROME_STATIC_IP=172.19.0.19
NAVIDROME_STATIC_IP_NGINX=172.18.0.21
LIDARR_PAUL_STATIC_IP=172.19.0.22
LIDARR_LISA_STATIC_IP=172.19.0.23
SOULARR_STATIC_IP=172.19.0.24

HTTPPROXY_USERL=privoxy
HTTPPROXY_PASSWORD=changeme-privoxy-password

# Navidrome scrobbling/metadata API credentials
ND_LASTFM_APIKEY=changeme-lastfm-api-key
ND_LASTFM_SECRET=changeme-lastfm-shared-secret
ND_SPOTIFY_ID=changeme-spotify-client-id
ND_SPOTIFY_SECRET=changeme-spotify-client-secret

SLSKD_USERNAME=slskd
SLSKD_PASSWORD='changeme-slskd-web-password'
SLSKD_SLSK_USERNAME=changeme-soulseek-username
SLSKD_SLSK_PASSWORD=changeme-soulseek-password
